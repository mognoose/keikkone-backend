NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://keikkone:keikkone@localhost:5433/keikkone?schema=public"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Migrations only: a direct (non-pooled) connection. Unset locally, where
# DATABASE_URL is already direct. Never put production URLs in .env, since
# `npm run db:migrate` (migrate dev) can reset the database it points at.
# DIRECT_URL=

# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGINS="http://localhost:3000"

# Reverse proxies in front of the app (Cloud Run: 1), so rate limiting sees real client IPs
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
